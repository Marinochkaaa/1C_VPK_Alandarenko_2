&НаКлиенте
Процедура Загрузить(Команда)
	Если ПустаяСтрока(ПутьJSON) Тогда
		Сообщить("Укажите путь к JSON-файлу.");
		Возврат;
	КонецЕсли;
	ЧислоЗаписей = ПроверитьJSONНаСервере();
	Сообщить("Документов в файле: " + Строка(ЧислоЗаписей));
КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)
	Если ПустаяСтрока(ПутьJSON) Тогда
		Сообщить("Укажите путь к JSON-файлу.");
		Возврат;
	КонецЕсли;
	СоздатьДокументыНаСервере();
	Сообщить("Создание документов завершено.");
КонецПроцедуры

&НаСервере
Функция ПроверитьJSONНаСервере()
	Возврат ПрочитатьНакладныеИзJSON().Количество();
КонецФункции

&НаСервере
Функция ПрочитатьНакладныеИзJSON()
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьJSON, "UTF-8");
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение "Корень JSON должен быть массивом.";
	КонецЕсли;
	Для Каждого ОбъектJSON Из Данные Цикл
		Если ТипЗнч(ОбъектJSON) <> Тип("Структура") Тогда
			ВызватьИсключение "Элемент массива - не объект.";
		КонецЕсли;
		ТоварыJSON = Неопределено;
		Если Не ОбъектJSON.Свойство("Товары", ТоварыJSON)
			Или ТипЗнч(ТоварыJSON) <> Тип("Массив") Тогда
			ВызватьИсключение "Нет массива Товары.";
		КонецЕсли;
	КонецЦикла;
	Возврат Данные;
КонецФункции

&НаСервере
Функция НайтиПоНаименованию(Справочник, Имя)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ссылка
	|ИЗ Справочник." + Справочник + "
	|ГДЕ Наименование = &Имя И НЕ ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Не найдено (" + Справочник + "): " + Имя;
	КонецЕсли;
	Ссылка = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Несколько совпадений (" + Справочник + "): " + Имя;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

&НаСервере
Процедура СоздатьДокументыНаСервере()
	Накладные = ПрочитатьНакладныеИзJSON();

	// Сначала проверяем и находим все ссылки, документы пока не создаём
	Подготовлено = Новый Массив;
	Для Каждого Исх Из Накладные Цикл
		Опис = Новый Структура;
		Опис.Вставить("Дата", XMLЗначение(Тип("Дата"), Исх.ДатаДокумента));
		Опис.Вставить("Организация", НайтиПоНаименованию("Организации", Исх.Организация));
		Опис.Вставить("Контрагент", НайтиПоНаименованию("Контрагенты", Исх.Контрагент));
		Опис.Вставить("Склад", НайтиПоНаименованию("СтруктурныеЕдиницы", Исх.Склад));
		Строки = Новый Массив;
		Для Каждого Позиция Из Исх.Товары Цикл
			Стр = Новый Структура;
			Стр.Вставить("Номенклатура", НайтиПоНаименованию("Номенклатура", Позиция.Номенклатура));
			Стр.Вставить("Количество", Позиция.Количество);
			Стр.Вставить("Сумма", Позиция.Сумма);
			Строки.Добавить(Стр);
		КонецЦикла;
		Опис.Вставить("Строки", Строки);
		Подготовлено.Добавить(Опис);
	КонецЦикла;

	// Теперь создаём документы без проведения
	Для Каждого Опис Из Подготовлено Цикл
		Док = Документы.РасходнаяНакладная.СоздатьДокумент();
		Док.Дата = Опис.Дата;
		Док.Организация = Опис.Организация;
		Док.Контрагент = Опис.Контрагент;
		Док.СтруктурнаяЕдиница = Опис.Склад;
		Для Каждого Стр Из Опис.Строки Цикл
			СтрокаТЧ = Док.Запасы.Добавить();
			СтрокаТЧ.Номенклатура = Стр.Номенклатура;
			СтрокаТЧ.ЕдиницаИзмерения = Стр.Номенклатура.ЕдиницаИзмерения;
			СтрокаТЧ.Количество = Стр.Количество;
			СтрокаТЧ.Сумма = Стр.Сумма;
			Если Стр.Количество <> 0 Тогда
				СтрокаТЧ.Цена = Стр.Сумма / Стр.Количество;
			КонецЕсли;
		КонецЦикла;
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
КонецПроцедуры