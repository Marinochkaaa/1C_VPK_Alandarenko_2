&НаКлиенте
Процедура Загрузить(Команда)
	Если ПустаяСтрока(ПутьExcel) Тогда
		Сообщить("Укажите путь к Excel-файлу.");
		Возврат;
	КонецЕсли;
	РезультатИмпорта = "";
	ЗагрузитьExcelНаСервере();
КонецПроцедуры

&НаСервере
Функция ЕстьКонтрагентСИНН(ИНН)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
	|ИЗ Справочник.Контрагенты
	|ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

&НаСервере
Процедура ЗагрузитьExcelНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ПутьExcel, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Создано = 0;
	Дубли = 0;
	Лог = "";
	Для НомерСтроки = 2 По ТабДок.ВысотаТаблицы Цикл
		Краткое = СокрЛП(ТабДок.Область(НомерСтроки, 1).Текст);
		Полное  = СокрЛП(ТабДок.Область(НомерСтроки, 2).Текст);
		Вид     = СокрЛП(ТабДок.Область(НомерСтроки, 3).Текст);
		ИНН     = СтрЗаменить(СтрЗаменить(СокрЛП(ТабДок.Область(НомерСтроки, 4).Текст), " ", ""), Символ(160), "");
		КПП     = СтрЗаменить(СтрЗаменить(СокрЛП(ТабДок.Область(НомерСтроки, 5).Текст), " ", ""), Символ(160), "");
		Если ПустаяСтрока(ИНН) Тогда
			Лог = Лог + "Пропущена строка " + Строка(НомерСтроки) + ": не указан ИНН" + Символы.ПС;
			Продолжить;
		КонецЕсли;
		Если ЕстьКонтрагентСИНН(ИНН) Тогда
			Дубли = Дубли + 1;
			Лог = Лог + "Контрагент с ИНН " + ИНН + " уже существует" + Символы.ПС;
			Продолжить;
		КонецЕсли;
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Наименование = Краткое;
		НовыйКонтрагент.НаименованиеПолное = Полное;
		НовыйКонтрагент.ИНН = ИНН;
		НовыйКонтрагент.КПП = КПП;
				Если Найти(НРег(Вид), "юридическое") > 0 Тогда
			НовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		Иначе
			НовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		КонецЕсли;
		НовыйКонтрагент.Записать();
		Создано = Создано + 1;
		Лог = Лог + "Создан контрагент: " + Краткое + " (ИНН " + ИНН + ")" + Символы.ПС;
	КонецЦикла;
	Лог = Лог + "Создано: " + Строка(Создано) + ", дублей: " + Строка(Дубли);
	РезультатИмпорта = Лог;
	Сообщить(Лог);
КонецПроцедуры