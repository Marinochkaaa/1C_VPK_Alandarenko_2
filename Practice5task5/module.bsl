&НаКлиенте
Процедура GET(Команда)
	Если ПустаяСтрока(АдресЗапроса) Тогда
		Сообщить("Введите URL-адрес.");
		Возврат;
	КонецЕсли;
	Ответ = "";
	ВыполнитьGETНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьGETНаСервере()
	Адрес = СокрЛП(АдресЗапроса);
	Защищенное = Ложь;
	Если НРег(Лев(Адрес, 8)) = "https://" Тогда
		Защищенное = Истина;
		Адрес = Сред(Адрес, 9);
	ИначеЕсли НРег(Лев(Адрес, 7)) = "http://" Тогда
		Адрес = Сред(Адрес, 8);
	КонецЕсли;

	ПозицияСлеша = Найти(Адрес, "/");
	Если ПозицияСлеша = 0 Тогда
		ХостПорт = Адрес;
		Путь = "/";
	Иначе
		ХостПорт = Лев(Адрес, ПозицияСлеша - 1);
		Путь = Сред(Адрес, ПозицияСлеша);
	КонецЕсли;

	ПозицияДвоеточия = Найти(ХостПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Хост = Лев(ХостПорт, ПозицияДвоеточия - 1);
		Порт = Число(Сред(ХостПорт, ПозицияДвоеточия + 1));
	Иначе
		Хост = ХостПорт;
		Порт = ?(Защищенное, 443, 80);
	КонецЕсли;

	Попытка
		Если Защищенное Тогда
			Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
		Иначе
			Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30);
		КонецЕсли;
		Запрос = Новый HTTPЗапрос(Путь);
		Результат = Соединение.Получить(Запрос);
		Ответ = "Код состояния: " + Строка(Результат.КодСостояния) + Символы.ПС
			+ Результат.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Ответ = "Ошибка запроса: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры