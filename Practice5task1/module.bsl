&НаКлиенте
Процедура Выгрузить(Команда)
	Если Не ЗначениеЗаполнено(НачалоПериода)
		Или Не ЗначениеЗаполнено(КонецПериода)
		Или ПустаяСтрока(ПутьФайла) Тогда
		Сообщить("Заполните период и путь к JSON-файлу.");
		Возврат;
	КонецЕсли;
	Если НачалоПериода > КонецПериода Тогда
		Сообщить("Начало периода больше конца.");
		Возврат;
	КонецЕсли;
	Количество = ВыгрузитьНаСервере();
	Сообщить("Выгружено накладных: " + Строка(Количество));
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Накладная.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК Накладная
	|ГДЕ
	|	Накладная.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ Накладная.ПометкаУдаления";
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Выборка = Запрос.Выполнить().Выбрать();

	РезультатJSON = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Ссылка.ПолучитьОбъект();
		СтрокиJSON = Новый Массив;
		Для Каждого СтрокаТовара Из Док.Запасы Цикл
			Позиция = Новый Структура;
			Позиция.Вставить("Номенклатура", ДокСтрокаИмя(СтрокаТовара.Номенклатура));
			Позиция.Вставить("Количество", СтрокаТовара.Количество);
			Позиция.Вставить("Сумма", СтрокаТовара.Сумма);
			СтрокиJSON.Добавить(Позиция);
		КонецЦикла;
		Данные = Новый Структура;
		Данные.Вставить("ДатаДокумента", XMLСтрока(Док.Дата));
		Данные.Вставить("Организация", ДокСтрокаИмя(Док.Организация));
		Данные.Вставить("Контрагент", ДокСтрокаИмя(Док.Контрагент));
		Данные.Вставить("Склад", ДокСтрокаИмя(Док.СтруктурнаяЕдиница));
		Данные.Вставить("Товары", СтрокиJSON);
		РезультатJSON.Добавить(Данные);
	КонецЦикла;

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла, КодировкаТекста.UTF8);
	ЗаписатьJSON(Запись, РезультатJSON);
	Запись.Закрыть();
	Возврат РезультатJSON.Количество();
КонецФункции

&НаСервере
Функция ДокСтрокаИмя(Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение.Наименование;
КонецФункции